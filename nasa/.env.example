# Keep your real keys in .env (never commit .env to git)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Realtime voice model (WebSocket /ws/voice)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_TTS_VOICE=alloy

# Text fallback / REST models (/api/voice/chat, /api/voice/turn)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Comma-separated frontend origins for Stitch / JS client
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
